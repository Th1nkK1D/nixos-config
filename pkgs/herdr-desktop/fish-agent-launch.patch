--- a/src/programs.rs
+++ b/src/programs.rs
@@ -258,7 +258,7 @@ fn resolve(t: &Table, app: Option<&str>, argv: &[String]) -> Value {
         && t.shells.iter().any(|s| s == base(&argv[0]))
