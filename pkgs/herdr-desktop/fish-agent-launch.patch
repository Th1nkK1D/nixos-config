diff --git a/src/window.rs b/src/window.rs
index 50581eb..ca8ba63 100644
--- a/src/window.rs
+++ b/src/window.rs
@@ -2149,7 +2149,13 @@ impl AppWindow {
                 // PowerShell has no `-ic`: run it, then stay. `&` finds npm's `.cmd` shims too.
                 return vec![sh, "-NoExit".into(), "-Command".into(), crate::programs::powershell_line(&cmd)];
             }
-            let mut run = vec![sh.clone(), "-ic".into(), "\"$@\"; exec \"$0\" -i".into(), sh];
+            // fish has no `$@` or `$0`: its arguments, the shell first, are all in `$argv`
+            let line = if sh.rsplit('/').next() == Some("fish") {
+                "set -l sh $argv[1]; set -e argv[1]; $argv; exec $sh -i"
+            } else {
+                "\"$@\"; exec \"$0\" -i"
+            };
+            let mut run = vec![sh.clone(), "-ic".into(), line.into(), sh];
             run.extend(cmd);
             run
         })
