new file mode 100644
index 0000000..d3e6105
--- /dev/null
+++ b/chroma.go
@@ -0,0 +1,163 @@
+package main
+
+import (
+	"path"
+	"strings"
+	"time"
+
+	"github.com/alecthomas/chroma/v2"
+	"github.com/alecthomas/chroma/v2/lexers"
+	"github.com/egoist/mygo/ui/editor"
+)
+
+// Chroma re-tokenizes the whole file after each edit, so big ones stay plain.
+const chromaMax = 512 << 10
+
+var chromaAliases = map[string]string{".astro": "svelte", ".mdx": "markdown"}
+
+func languageFor(name string) *editor.Language {
+	if l := editor.LanguageFor(name); l != nil {
+		return l
+	}
+	lx := lexers.Match(name)
+	if lx == nil {
+		lx = lexers.Get(chromaAliases[path.Ext(name)])
+	}
+	if lx == nil {
+		return nil
+	}
+	front := path.Ext(name) == ".astro"
+	return &editor.Language{
+		Name: lx.Config().Name,
+		Highlighter: func(text editor.Snapshot, _ func()) editor.Highlighter {
+			return &chromaHighlighter{lx: lx, front: front, text: text, stale: true}
+		},
+	}
+}
+
+func frontmatterLines(lx chroma.Lexer, text string) [][]editor.Token {
+	if end := strings.Index(text, "\n---\n"); strings.HasPrefix(text, "---\n") && end >= 0 {
+		end += len("\n---\n")
+		if ts := lexers.Get("typescript"); ts != nil {
+			head := tokenLines(ts, text[:end])
+			return append(head[:len(head)-1], tokenLines(lx, text[end:])...)
+		}
+	}
+	return tokenLines(lx, text)
+}
+
+type chromaHighlighter struct {
+	lx    chroma.Lexer
+	front bool
+	text editor.Snapshot
+	lines [][]editor.Token
+	stale bool
+}
+
+func (h *chromaHighlighter) Edit(_, new editor.Snapshot, _ []editor.Change) {
+	h.text, h.stale = new, true
+}
+
+func (h *chromaHighlighter) Highlight(_ int, _ time.Duration) bool {
+	if h.stale {
+		h.lines, h.stale = nil, false
+		if h.text.Len() <= chromaMax {
+			if h.front {
+				h.lines = frontmatterLines(h.lx, h.text.String())
+			} else {
+				h.lines = tokenLines(h.lx, h.text.String())
+			}
+		}
+	}
+	return true
+}
+
+func (h *chromaHighlighter) Tokens(i int, text string, dst []editor.Token) ([]editor.Token, bool) {
+	if i < len(h.lines) {
+		for _, t := range h.lines[i] {
+			if t.End > len(text) {
+				t.End = len(text)
+			}
+			dst = append(dst, t)
+		}
+	}
+	return dst, !h.stale
+}
+
+func tokenLines(lx chroma.Lexer, text string) [][]editor.Token {
+	it, err := lx.Tokenise(nil, text)
+	if err != nil {
+		return nil
+	}
+	lines := [][]editor.Token{nil}
+	col := 0
+	for tok := it(); tok != chroma.EOF; tok = it() {
+		kind := tokenKind(tok.Type)
+		rest := tok.Value
+		for {
+			part, after, more := strings.Cut(rest, "\n")
+			if part != "" {
+				col += len(part)
+				last := len(lines) - 1
+				if n := len(lines[last]); n > 0 && lines[last][n-1].Kind == kind {
+					lines[last][n-1].End = col
+				} else {
+					lines[last] = append(lines[last], editor.Token{End: col, Kind: kind})
+				}
+			}
+			if !more {
+				break
+			}
+			lines, col, rest = append(lines, nil), 0, after
+		}
+	}
+	return lines
+}
+
+func tokenKind(t chroma.TokenType) editor.TokenKind {
+	switch {
+	case t == chroma.KeywordType, t == chroma.NameClass, t == chroma.NameNamespace, t == chroma.NameException:
+		return editor.TokenType
+	case t == chroma.KeywordConstant, t == chroma.NameConstant, t == chroma.NameBuiltinPseudo:
+		return editor.TokenConstant
+	case t == chroma.NameFunction, t == chroma.NameFunctionMagic, t == chroma.NameBuiltin:
+		return editor.TokenFunction
+	case t == chroma.NameTag:
+		return editor.TokenTag
+	case t == chroma.NameAttribute:
+		return editor.TokenAttribute
+	case t == chroma.NameProperty:
+		return editor.TokenProperty
+	case t == chroma.NameDecorator, t == chroma.CommentPreproc, t == chroma.CommentPreprocFile:
+		return editor.TokenMeta
+	case t == chroma.NameVariable, t.InSubCategory(chroma.NameVariable):
+		return editor.TokenVariable
+	case t == chroma.LiteralStringEscape, t == chroma.LiteralStringInterpol:
+		return editor.TokenEscape
+	case t == chroma.LiteralStringRegex:
+		return editor.TokenRegexp
+	case t.InCategory(chroma.Keyword):
+		return editor.TokenKeyword
+	case t.InSubCategory(chroma.LiteralString):
+		return editor.TokenString
+	case t.InSubCategory(chroma.LiteralNumber):
+		return editor.TokenNumber
+	case t.InCategory(chroma.Comment):
+		return editor.TokenComment
+	case t.InCategory(chroma.Operator):
+		return editor.TokenOperator
+	case t == chroma.Punctuation:
+		return editor.TokenPunctuation
+	case t == chroma.GenericDeleted:
+		return editor.TokenDeleted
+	case t == chroma.GenericInserted:
+		return editor.TokenInserted
+	case t == chroma.GenericHeading, t == chroma.GenericSubheading:
+		return editor.TokenHeading
+	case t == chroma.GenericEmph:
+		return editor.TokenEmphasis
+	case t == chroma.GenericStrong:
+		return editor.TokenStrong
+	}
+	return editor.TokenText
+}
