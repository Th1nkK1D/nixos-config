diff --git a/mygo-orig/plugins/terminal/internal/vt/rows.go b/mygo-new/plugins/terminal/internal/vt/rows.go
index 523951a..9cde3e3 100644
--- a/mygo-orig/plugins/terminal/internal/vt/rows.go
+++ b/mygo-new/plugins/terminal/internal/vt/rows.go
@@ -10,12 +10,28 @@ import (
 // reads.
 
 const (
-	rowDataWrap = 1
+	rowDataWrap           = 1
+	rowDataSemanticPrompt = 6
 
 	dataKittyKeyboardFlags = 8
 	dataScrollbackRows     = 15
 )
 
+// PromptRow reports whether row y of the viewport belongs to a shell prompt
+// (OSC 133), where a click can move the cursor.
+func (t *Terminal) PromptRow(y int) bool {
+	ref, found := t.CellAt(0, y)
+	if !found {
+		return false
+	}
+	var row uint64
+	if !ok(call(fnGridRefRow, uintptr(unsafe.Pointer(&ref)), uintptr(unsafe.Pointer(&row)))) {
+		return false
+	}
+	var v int32
+	return ok(call(fnRowData, uintptr(row), rowDataSemanticPrompt, uintptr(unsafe.Pointer(&v)))) && v != 0
+}
+
 // ScrollbackRows returns how many rows the scrollback holds.
 func (t *Terminal) ScrollbackRows() int {
 	var n uintptr
