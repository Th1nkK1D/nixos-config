+// RowPrompt reports whether the row belongs to a shell prompt (OSC 133).
+func (r *RenderState) RowPrompt() bool {
+	var raw uint64
+	if !r.rowGet(rowDataRaw, unsafe.Pointer(&raw)) {
+		return false
+	}
+	var v int32
+	return ok(call(fnRowData, uintptr(raw), rowDataSemanticPrompt, uintptr(unsafe.Pointer(&v)))) && v != 0
+}
