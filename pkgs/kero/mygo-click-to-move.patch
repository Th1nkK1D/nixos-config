+// clickToMove moves the shell's cursor to the cell clicked on its prompt
+// line, or on a row the line wraps over, by typing arrow keys, and reports
+// whether it did. It stops at the end of the text: a Right arrow there
+// would accept a suggestion; t.mu is held.
+func (v *view) clickToMove(col, row int) bool {
+	term := v.t.term
+	cx, cy := term.Cursor()
+	if term.AltScreen() || !term.AtBottom() || term.PromptKind(cy) == 0 {
+		return false
+	}
+	// The input starts where the prompt does and goes on over the rows
+	// that follow it, above and below the cursor's.
+	_, rows := term.Size()
+	top, bottom := cy, cy
+	for top > 0 && term.PromptKind(top) == 2 {
+		top--
+	}
+	for bottom+1 < rows && term.PromptKind(bottom+1) == 2 {
+		bottom++
+	}
+	if row < top || row > bottom {
+		return false
+	}
+	// extent returns the columns of a row's cells, and the end of its text.
+	extent := func(y int) ([]int, int) {
+		text, cols := term.RowText(y)
+		end := 0
+		for i, r := range text {
+			if r != ' ' {
+				end = cols[i] + 1
+			}
+		}
+		return cols, end
+	}
+	steps, key := 0, "D"
+	if row < cy {
+		cols, end := extent(row)
+		for _, c := range cols {
+			if c >= col && c < end {
+				steps++
+			}
+		}
+		for y := row + 1; y < cy; y++ {
+			cols, end := extent(y)
+			for _, c := range cols {
+				if c < end {
+					steps++
+				}
+			}
+		}
+		cols, _ = extent(cy)
+		for _, c := range cols {
+			if c < cx {
+				steps++
+			}
+		}
+	} else if row > cy {
+		key = "C"
+		cols, end := extent(cy)
+		for _, c := range cols {
+			if c >= cx && c < end {
+				steps++
+			}
+		}
+		for y := cy + 1; y < row; y++ {
+			cols, end := extent(y)
+			for _, c := range cols {
+				if c < end {
+					steps++
+				}
+			}
+		}
+		cols, end = extent(row)
+		for _, c := range cols {
+			if c < min(col, end) {
+				steps++
+			}
+		}
+	} else {
+		cols, end := extent(cy)
+		end = max(end, cx)
+		col = min(col, end)
+		lo, hi := col, cx
+		if col > cx {
+			lo, hi, key = cx, col, "C"
+		}
+		for _, c := range cols {
+			if c >= lo && c < hi {
+				steps++
+			}
+		}
+	}
+	intro := "\x1b["
+	if term.Mode(vt.ModeCursorKeys) {
+		intro = "\x1bO"
+	}
+	v.t.Send([]byte(strings.Repeat(intro+key, steps)))
+	return true
+}
