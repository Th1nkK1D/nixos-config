@@ -1106,6 +1109,42 @@ func (v *view) pointerEvent(ev ui.InputEvent) bool {
 	return false
 }
 
+// clickToMove moves the shell's cursor to the cell clicked on its prompt
+// line, by typing arrow keys, and reports whether it did. It stops at the
+// end of the text: a Right arrow there would accept a suggestion; t.mu is
+// held.
+func (v *view) clickToMove(col, row int) bool {
+	term := v.t.term
+	cx, cy := term.Cursor()
+	if row != cy || term.AltScreen() || !term.AtBottom() || !term.PromptRow(cy) {
+		return false
+	}
+	text, cols := term.RowText(row)
+	end := cx
+	for i, r := range text {
+		if r != ' ' {
+			end = max(end, cols[i]+1)
+		}
+	}
+	col = min(col, end)
+	lo, hi, key := col, cx, "D"
+	if col > cx {
+		lo, hi, key = cx, col, "C"
+	}
+	steps := 0
+	for _, c := range cols {
+		if c >= lo && c < hi {
+			steps++
+		}
+	}
+	intro := "\x1b["
+	if term.Mode(vt.ModeCursorKeys) {
+		intro = "\x1bO"
+	}
+	v.t.Send([]byte(strings.Repeat(intro+key, steps)))
+	return true
+}
