+// PromptKind tells how row y of the viewport belongs to a shell prompt
+// (OSC 133), where a click can move the cursor: 0 not, 1 where the prompt
+// starts, 2 where it goes on.
+func (t *Terminal) PromptKind(y int) int {
+	ref, found := t.CellAt(0, y)
+	if !found {
+		return 0
+	}
+	var row uint64
+	if !ok(call(fnGridRefRow, uintptr(unsafe.Pointer(&ref)), uintptr(unsafe.Pointer(&row)))) {
+		return 0
+	}
+	var v int32
+	if !ok(call(fnRowData, uintptr(row), rowDataSemanticPrompt, uintptr(unsafe.Pointer(&v)))) {
+		return 0
+	}
+	return int(v)
+}
