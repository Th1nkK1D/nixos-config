diff --git a/wakatime.go b/wakatime.go
new file mode 100644
index 0000000..295b8e9
--- /dev/null
+++ b/wakatime.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"os/exec"
+	"strconv"
+	"sync"
+	"time"
+
+	"kero/internal/proto"
+)
+
+// Kero sends WakaTime heartbeats for the files of this computer the user
+// opens, edits and saves in the viewer, through wakatime-cli, which reads
+// ~/.wakatime.cfg. Coding agents' own plugins send theirs, under their own
+// plugin name, so none counts twice. No wakatime-cli on the PATH, no
+// heartbeats.
+
+const wakaEvery = 2 * time.Minute
+
+var waka struct {
+	once sync.Once
+	bin  string
+	mu   sync.Mutex
+	last map[string]time.Time
+}
+
+// wakaBeat sends a heartbeat for a file: a write always, else at most
+// every wakaEvery for the file.
+func wakaBeat(file, category string, write bool) {
+	waka.once.Do(func() { waka.bin, _ = exec.LookPath("wakatime-cli") })
+	if waka.bin == "" {
+		return
+	}
+	waka.mu.Lock()
+	if waka.last == nil {
+		waka.last = map[string]time.Time{}
+	}
+	if !write && time.Since(waka.last[file]) < wakaEvery {
+		waka.mu.Unlock()
+		return
+	}
+	waka.last[file] = time.Now()
+	waka.mu.Unlock()
+	args := []string{"--entity", file, "--category", category, "--plugin", "kero/" + strconv.Itoa(proto.Version)}
+	if write {
+		args = append(args, "--write")
+	}
+	go exec.Command(waka.bin, args...).Run()
+}
+
+// wakaOpened is the heartbeat of a file the user opens in the viewer, to
+// read.
+func (a *App) wakaOpened(pane, file string) {
+	if !a.hostOf(pane).remote() {
+		wakaBeat(file, "code reviewing", false)
+	}
+}
+
+// wakaEdited is the heartbeat of a text the user edits, as its buffer's
+// version moves past the last it sent one for; the viewer calls it as it
+// draws.
+func (a *App) wakaEdited(t editTarget) {
+	if t.buf == nil || !t.buf.Modified() || a.hostOf(t.pane).remote() {
+		return
+	}
+	if v := t.buf.Version(); v != t.edits.beat {
+		t.edits.beat = v
+		wakaBeat(t.path, "coding", false)
+	}
+}
